    "alignment": 1.0,
    "cues": [
      {
        "start": 0.185,
        "end": 4.272,
        "text": "أمامك مسمار حديد. أضف الماء، ثم عرّضه للهواء، ثم"
      },
      {
        "start": 4.388,
        "end": 8.626,
        "text": "تابع مرور الزمن المسرّع. ما الذي يتغير؟ احتفظ بتوقعك،"
      },
      {
        "start": 8.8,
        "end": 10.843,
        "text": "ثم استند إلى الملاحظة في إجابتك."
      }
    ]
  },
