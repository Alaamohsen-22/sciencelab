    "alignment": 1.0,
    "cues": [
      {
        "start": 0.168,
        "end": 4.533,
        "text": "الأكسيد مركب يتكوّن من الأكسجين وعنصر آخر. قارن مثال"
      },
      {
        "start": 4.58,
        "end": 8.875,
        "text": "الكبريت بمثال الكالسيوم. لون اللهب لا يساوي لون الغاز،"
      },
      {
        "start": 9.05,
        "end": 13.125,
        "text": "ولا نعمم على كل أكاسيد الفلزات واللافلزات. لا تُجرِ"
      },
      {
        "start": 13.148,
        "end": 14.715,
        "text": "التجربة خارج المحاكاة."
      }
    ]
  },
