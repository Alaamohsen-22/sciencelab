  "bonds-page-1": {
    "file": "assets/audio/phase2/bonds-page-1.mp3",
    "text_sha256": "11fc08cc6afb4edf07d3827da64970bed99f79d450148af210d4baf7583ed176",
    "voice_id": "EUojVLG1QfxaqqH4ce6s",
    "voice_name": "Razan – Academic & Cultural Narration",
    "model": "eleven_multilingual_v2",
    "batch": "batch-1",
    "duration": 12.835,
    "bytes": 103278,
    "sha256": "9e1d6ddf12aed24701d15f03a84cc8319230dbf687df035794820ba76df7380f",
    "alignment": 1.0,
    "cues": [
      {
        "start": 0.081,
        "end": 5.283,
        "text": "ابدأ بذرتي الليثيوم والفلور. التوزيع الإلكتروني لليثيوم اثنان، واحد؛"
      },
      {
        "start": 5.492,
        "end": 10.472,
        "text": "وللفلور اثنان، سبعة. اضغط زر المشاهدة لتتبع إلكترون التكافؤ،"
      },
      {
        "start": 10.635,
        "end": 12.69,
        "text": "ثم جرّب نقله بنفسك في النشاط."
      }
    ]
  },
  "bonds-page-2": {
    "file": "assets/audio/phase2/bonds-page-2.mp3",
    "text_sha256": "a347b8e0c38b76a3116368f6d9aa61e02024e91be0faa3b84714899212050050",
    "voice_id": "EUojVLG1QfxaqqH4ce6s",
    "voice_name": "Razan – Academic & Cultural Narration",
    "model": "eleven_multilingual_v2",
    "batch": "batch-1",
    "duration": 13.455,
    "bytes": 108294,
    "sha256": "baf5dabb8b55d5c611968c8952012599558ced242c957fdf84f0d9d1bc58075e",
    "alignment": 1.0,
    "cues": [
      {
        "start": 0.145,
        "end": 4.882,
        "text": "أمامك ذرة مغنيسيوم وذرتا كلور. توزيع المغنيسيوم اثنان، ثمانية،"
      },
      {
        "start": 4.975,
        "end": 9.723,
        "text": "اثنان؛ وتوزيع كل ذرة كلور اثنان، ثمانية، سبعة. تتبّع"
      },
      {
        "start": 9.781,
        "end": 13.415,
        "text": "إلكتروني التكافؤ في المثال، ثم كوّن الارتباط بنفسك."
      }
    ]
  },
  "bonds-page-3": {
    "file": "assets/audio/phase2/bonds-page-3.mp3",
    "text_sha256": "3c590ec08dfd6037053c945d52e39c28b60197ca851fe6bbf20df22eb7fa5170",
    "voice_id": "EUojVLG1QfxaqqH4ce6s",
    "voice_name": "Razan – Academic & Cultural Narration",
    "model": "eleven_multilingual_v2",
    "batch": "batch-1",
    "duration": 11.094,
    "bytes": 89277,
    "sha256": "d9fe2aca0606e0167932c33c772bc8b0384e26510ceef4ba9dc8babf756c18ef",
    "alignment": 1.0,
    "cues": [
      {
        "start": 0.041,
        "end": 4.871,
        "text": "لذرة الهيدروجين إلكترون واحد. شاهد اقتراب الذرتين، وتتبع الإلكترونين"
      },
      {
        "start": 4.918,
        "end": 8.679,
        "text": "في منطقة التداخل. بعد المثال اختر إلكترونًا من كل"
      },
      {
        "start": 8.772,
        "end": 10.967,
        "text": "ذرة ونفّذ المشاركة بنفسك."
      }
    ]
  },
  "bonds-page-4": {
    "file": "assets/audio/phase2/bonds-page-4.mp3",
    "text_sha256": "6196e561ea6860031fad03db3aa72f1f38c00eb5373b079ff5b6080743039c0c",
    "voice_id": "EUojVLG1QfxaqqH4ce6s",
    "voice_name": "Razan – Academic & Cultural Narration",
    "model": "eleven_multilingual_v2",
    "batch": "batch-1",
    "duration": 12.097,
    "bytes": 97427,
    "sha256": "e61b65c131e6925499f87d35ee49dc377dc349a585689789ca4c43baedc0f071",
    "alignment": 1.0,
    "cues": [
      {
        "start": 0.127,
        "end": 4.969,
        "text": "توزيع الأكسجين اثنان، ستة. تتبع إلكترونات التكافؤ في الذرتين."
      },
      {
        "start": 5.143,
        "end": 9.23,
        "text": "شاهد المثال لتتعرف إلى عدد الأزواج المشتركة، ثم أنشئ"
      },
      {
        "start": 9.264,
        "end": 11.981,
        "text": "الرابطة بنفسك وقارن تمثيلك بالرسم."
      }
    ]
  },
  "bonds-page-5": {
    "file": "assets/audio/phase2/bonds-page-5.mp3",
    "text_sha256": "7d1725bcf101863113332db1027a176fc03b3e3a4640d03525b8c0f5d007ba35",
    "voice_id": "EUojVLG1QfxaqqH4ce6s",
    "voice_name": "Razan – Academic & Cultural Narration",
    "model": "eleven_multilingual_v2",
    "batch": "batch-1",
    "duration": 16.266,
    "bytes": 130655,
    "sha256": "36ec5856e366e66402fba4b1806d4c6dd268cd8b3d979377ca251aad54d8ad1f",
    "alignment": 1.0,
    "cues": [
      {
        "start": 0.116,
        "end": 5.248,
        "text": "أمامك كربون وأربع ذرات هيدروجين. للكربون أربعة إلكترونات تكافؤ،"
      },
      {
        "start": 5.399,
        "end": 10.124,
        "text": "ولكل هيدروجين إلكترون واحد. اختر جهة رابطة، وشارك إلكترونًا"
      },
      {
        "start": 10.159,
        "end": 14.269,
        "text": "من الكربون وإلكترونًا من الهيدروجين المقابل. كرّر ذلك في"
      },
      {
        "start": 14.292,
        "end": 16.092,
        "text": "الجهات الأربع، ثم تحقق."
      }
    ]
  },
  "bonds-page-6": {
    "file": "assets/audio/phase2/bonds-page-6.mp3",
    "text_sha256": "53cb36d67a8d4a75e2e702839fa8005a4d778afb7c1557370c6a6ec1d7746e8c",
    "voice_id": "EUojVLG1QfxaqqH4ce6s",
    "voice_name": "Razan – Academic & Cultural Narration",
    "model": "eleven_multilingual_v2",
    "batch": "batch-1",
    "duration": 10.623,
    "bytes": 85515,
    "sha256": "7620957f33ff2f72b30250784ed1d1d9cdc8c35b0089b6929cfe7739437e218c",
    "alignment": 1.0,
    "cues": [
      {
        "start": 0.174,
        "end": 5.062,
        "text": "اكتشف الفرق بين انتقال الإلكترونات ومشاركتها. صنّف الأمثلة واحدًا"
      },
      {
        "start": 5.097,
        "end": 9.311,
        "text": "واحدًا، واستند إلى كيفية تكوّن الرابطة، لا إلى حفظ"
      },
      {
        "start": 9.369,
        "end": 10.553,
        "text": "اسم الصيغة وحده."
      }
    ]
  },
  "bonds-page-7": {
    "file": "assets/audio/phase2/bonds-page-7.mp3",
    "text_sha256": "31abe73557490fc48d8e345b369fb4d6e18ea24fdfe21aeae8503a48cb84d08f",
    "voice_id": "EUojVLG1QfxaqqH4ce6s",
    "voice_name": "Razan – Academic & Cultural Narration",
    "model": "eleven_multilingual_v2",
    "batch": "batch-1",
    "duration": 13.316,
    "bytes": 107040,
    "sha256": "5e9736eb7868d131bc2324247738cb4fab56e459e34b5995b1f2ae0d574d80ad",
    "alignment": 1.0,
    "cues": [
      {
        "start": 0.07,
        "end": 4.795,
        "text": "خريطة الروابط تجمع علاقات الدرس. افتح مسار الأيونية، ثم"
      },
      {
        "start": 4.853,
        "end": 9.903,
        "text": "التساهمية، ثم قارن الأمثلة. اتبع الأسهم، وكبّر رسم الأزواج"
      },
      {
        "start": 9.973,
        "end": 13.27,
        "text": "أو انتقال الإلكترونات لتراجع الدليل قبل الاختبار."
      }
    ]
  },
  "compound-acid-ion": {
    "file": "assets/audio/phase2/compound-acid-ion.mp3",
    "text_sha256": "6cfabd0c6c017eb2f1d41e91f37ad145131869b7dc31911ab12ef4f856c51cc0",
    "voice_id": "EUojVLG1QfxaqqH4ce6s",
    "voice_name": "Razan – Academic & Cultural Narration",
    "model": "eleven_multilingual_v2",
    "batch": "batch-1",
    "duration": 18.042,
    "bytes": 144865,
    "sha256": "873757678cecec84b506d27cf71beb655cc41f737989f017a14c98eb4737782f",
    "alignment": 1.0,
    "cues": [
      {
        "start": 0.046,
        "end": 4.4,
        "text": "عند تأين حمض الهيدروكلوريك في الماء تتكون أيونات الهيدروجين"
      },
      {
        "start": 4.448,
        "end": 9.846,
        "text": "الموجبة والكلوريد السالبة. نستخدم الهيدروجين الموجب تمثيلًا مبسطًا كما"
      },
      {
        "start": 9.915,
        "end": 14.362,
        "text": "في المنهاج. ولحمض الكبريتيك في النموذج المبسط أيونا هيدروجين"
      },
      {
        "start": 14.409,
        "end": 17.984,
        "text": "موجب وأيون كبريتات بشحنتين سالبتين."
      }
    ]
  },
  "compounds-page-1": {
    "file": "assets/audio/phase2/compounds-page-1.mp3",
    "text_sha256": "48d8c6ed4e0e0aa9f53088ba2baaad30dba7aab7563c9aaaf0b6b0f813ef4e83",
    "voice_id": "EUojVLG1QfxaqqH4ce6s",
    "voice_name": "Razan – Academic & Cultural Narration",
    "model": "eleven_multilingual_v2",
    "batch": "batch-1",
    "duration": 16.69,
    "bytes": 133998,
    "sha256": "f17824381b364c632169016eef9bca76468f19dc5348272d961011eb22510e86",
    "alignment": 1.0,
    "cues": [
      {
        "start": 0.058,
        "end": 4.18,
        "text": "مرحبًا في محطة الحموض. تتكوّن أيونات الهيدروجين في الماء"
      },
      {
        "start": 4.226,
        "end": 8.789,
        "text": "وفق التمثيل المبسط في المنهاج. اكتشف أثر الكاشف والتوصيل"
      },
      {
        "start": 8.812,
        "end": 13.422,
        "text": "الكهربائي والتفاعل مع الفلز. لا تلمس مواد المختبر ولا"
      },
      {
        "start": 13.48,
        "end": 16.661,
        "text": "تتذوقها؛ التجارب الخطرة رقمية فقط."
      }
    ]
  },
  "use-acid-0": {
    "file": "assets/audio/phase2/use-acid-0.mp3",
    "text_sha256": "1ded8f08fea697a01b84bf18436370af5d46fb7e5eeecfb830074bb366fb978b",
    "voice_id": "EUojVLG1QfxaqqH4ce6s",
    "voice_name": "Razan – Academic & Cultural Narration",
    "model": "eleven_multilingual_v2",
    "batch": "batch-1",
    "duration": 6.095,
    "bytes": 49362,
    "sha256": "75ef06314f34efaeebca3a6dba2eba177ef1b1dcdb5b1177a60f5dd0ece02224",
    "alignment": 1.0,
    "cues": [
      {
        "start": 0.029,
        "end": 4.777,
        "text": "حمض الهيدروكلوريك. يوجد في معدة الإنسان. تأمل الصيغة واستخدام"
      },
      {
        "start": 4.812,
        "end": 5.973,
        "text": "المركب في البطاقة."
      }
    ]
  },
  "use-acid-1": {
    "file": "assets/audio/phase2/use-acid-1.mp3",
    "text_sha256": "1e9aeb74faa1ea151257806acfbabd30ab8baa7ee66dd57d8667e56c1d95d3e0",
    "voice_id": "EUojVLG1QfxaqqH4ce6s",
    "voice_name": "Razan – Academic & Cultural Narration",
    "model": "eleven_multilingual_v2",
    "batch": "batch-1",
    "duration": 6.258,
    "bytes": 50616,
    "sha256": "9d2ef5ca822f33096e561e43e4071901c6d830fd4c7dd9c411fbae1e17318f45",
    "alignment": 1.0,
    "cues": [
      {
        "start": 0.122,
        "end": 5.474,
        "text": "حمض الكبريتيك. بطاريات السيارات. تأمل الصيغة واستخدام المركب في"
      },
      {
        "start": 5.486,
        "end": 6.159,
        "text": "البطاقة."
      }
    ]
  },
  "use-acid-2": {
    "file": "assets/audio/phase2/use-acid-2.mp3",
    "text_sha256": "ca3aa9ff15a2a9dc66bc37defeb155f077ab098a7bf4d21adad7f7a816467114",
    "voice_id": "EUojVLG1QfxaqqH4ce6s",
    "voice_name": "Razan – Academic & Cultural Narration",
    "model": "eleven_multilingual_v2",
    "batch": "batch-1",
    "duration": 5.417,
    "bytes": 43928,
    "sha256": "3014ba4bec2994df1e1a03e7561c92628911b22e2b294e746b1bfcbd428278b4",
    "alignment": 1.0,
    "cues": [
      {
        "start": 0.099,
        "end": 4.603,
        "text": "حمض النيتريك. صناعة الأسمدة. تأمل الصيغة واستخدام المركب في"
      },
      {
        "start": 4.65,
        "end": 5.312,
        "text": "البطاقة."
      }
    ]
  },
  "use-acid-3": {
    "file": "assets/audio/phase2/use-acid-3.mp3",
    "text_sha256": "ff276f834a5591d4999e1f1ac2003f80025bf320a2b5a69415b15b7a0751c54c",
    "voice_id": "EUojVLG1QfxaqqH4ce6s",
    "voice_name": "Razan – Academic & Cultural Narration",
    "model": "eleven_multilingual_v2",
    "batch": "batch-1",
    "duration": 5.183,
    "bytes": 42047,
    "sha256": "84b43d9eb374c9789bbeec7f99019d944fd3767c87afb6c89d78d99ba5100669",
    "alignment": 1.0,
    "cues": [
      {
        "start": 0.105,
        "end": 4.4,
        "text": "حمض الخليك. صناعة الخل. تأمل الصيغة واستخدام المركب في"
      },
      {
        "start": 4.434,
        "end": 5.084,
        "text": "البطاقة."
      }
    ]
  },
  "compound-base-ion": {
    "file": "assets/audio/phase2/compound-base-ion.mp3",
    "text_sha256": "ed183e3ab7d2b3af539239935e2234b8bcc067876fcf06d8f25f472910d5eaf9",
    "voice_id": "EUojVLG1QfxaqqH4ce6s",
    "voice_name": "Razan – Academic & Cultural Narration",
    "model": "eleven_multilingual_v2",
    "batch": "batch-1",
    "duration": 14.896,
    "bytes": 119788,
    "sha256": "b3a92fbe8b39bdeb610a0a93ff0beab2cdb362c6a57beee8ec5a5c9a7e525987",
    "alignment": 1.0,
    "cues": [
      {
        "start": 0.099,
        "end": 4.754,
        "text": "يتفكك هيدروكسيد البوتاسيوم في الماء إلى أيون بوتاسيوم موجب"
      },
      {
        "start": 5.033,
        "end": 10.385,
        "text": "وأيون هيدروكسيل سالب. تبقى مجموعة الهيدروكسيل معًا. طبّق الفكرة"
      },
      {
        "start": 10.409,
        "end": 14.844,
        "text": "على هيدروكسيد الصوديوم، واحفظ عدد الذرات ومجموع الشحنة."
      }
    ]
  },
  "compounds-page-2": {
