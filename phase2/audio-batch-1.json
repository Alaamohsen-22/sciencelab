    "alignment": 1.0,
    "cues": [
      {
        "start": 0.052,
        "end": 4.998,
        "text": "في هذه الرحلة ستفسر التفاعل الكيميائي وتتعرف إلى دلالاته."
      },
      {
        "start": 5.079,
        "end": 9.595,
