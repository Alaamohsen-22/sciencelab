      }
    ]
  },
  "bond-result-mgcl2": {
    "file": "assets/audio/phase2/bond-result-mgcl2.mp3",
    "text_sha256": "5bd12b617cf291cea27b52f3db8e1bce1aec52288f0a4f6cfb6b9fe7456758f4",
    "voice_id": "EUojVLG1QfxaqqH4ce6s",
    "voice_name": "Razan – Academic & Cultural Narration",
    "model": "eleven_multilingual_v2",
