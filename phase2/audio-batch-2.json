{
  "reaction-page-4": {
    "file": "assets/audio/phase2/reaction-page-4.mp3",
    "text_sha256": "7595cef96599dc3b359dc22ff991186e6dd05eaf241a440e0201c73eab7d76de",
    "voice_id": "EUojVLG1QfxaqqH4ce6s",
    "voice_name": "Razan – Academic & Cultural Narration",
    "model": "eleven_multilingual_v2",
    "batch": "batch-2",
    "duration": 10.652,
    "bytes": 85724,
    "sha256": "54a6c8eff1d16908b2e45f1282b880ad2b721d92c6d21597870dc61096eb6d4c",
    "alignment": 1.0,
    "cues": [
      {
        "start": 0,
        "end": 3.843,
        "text": "هل تتساوى أعداد الذرات في الطرفين؟ غيّر معامل الماء،"
      },
      {
        "start": 4.017,
        "end": 8.533,
        "text": "ثم عُدّ ذرات الهيدروجين والأكسجين. المعامل يقع أمام الصيغة،"
      },
      {
        "start": 8.707,
        "end": 10.565,
        "text": "ولا يغيّر هوية المادة."
      }
    ]
  },
  "reaction-page-5": {
    "file": "assets/audio/phase2/reaction-page-5.mp3",
    "text_sha256": "559b58e11b7681898f48c7e6644f1cb76d503bd49dcb7d231e42937ff8a6a383",
    "voice_id": "EUojVLG1QfxaqqH4ce6s",
    "voice_name": "Razan – Academic & Cultural Narration",
    "model": "eleven_multilingual_v2",
    "batch": "batch-2",
    "duration": 16.004,
    "bytes": 128565,
    "sha256": "dbb4ab3a65f5294c9f928f9eba9c4866f9e2bc4816299d880384e65362cdf3fa",
    "alignment": 1.0,
    "cues": [
      {
        "start": 0.087,
        "end": 4.778,
        "text": "تختصر المعادلة الكيميائية أسماء المواد برموز وصيغ. السهم يربط"
      },
      {
        "start": 4.812,
        "end": 10.141,
        "text": "المتفاعلات بالنواتج، وقد تُكتب عليه ظروف التفاعل. غيّر المعاملات،"
      },
      {
        "start": 10.385,
        "end": 14.82,
        "text": "لا الأرقام داخل الصيغ. جرّب موازنة الكالسيوم، ثم أنجز"
      },
      {
        "start": 14.89,
        "end": 15.911,
        "text": "نشاط الأمونيا."
      }
    ]
  },
  "reaction-page-6": {
    "file": "assets/audio/phase2/reaction-page-6.mp3",
    "text_sha256": "a01b4e3b587c34b4c3a6f569470812d44eb50cabb03ae4003ea6e5544ca06e5c",
    "voice_id": "EUojVLG1QfxaqqH4ce6s",
    "voice_name": "Razan – Academic & Cultural Narration",
    "model": "eleven_multilingual_v2",
    "batch": "batch-2",
    "duration": 11.819,
    "bytes": 95128,
    "sha256": "f2ef9b392cb760cad96bbe813bfa77d328f2af5aa52e779e4b88556b25c6596b",
    "alignment": 1.0,
    "cues": [
      {
        "start": 0.093,
        "end": 4.586,
        "text": "جهز الدورق والخارصين والحمض المخفف والبالون في المختبر الرقمي."
      },
      {
        "start": 4.911,
        "end": 9.358,
        "text": "اتبع ترتيب الأدوات، وراقب البالون وما يحدث داخل الدورق."
      },
      {
        "start": 9.532,
        "end": 11.714,
        "text": "لا نستنتج قبل تنفيذ التفاعل."
      }
    ]
  },
  "reaction-page-7": {
    "file": "assets/audio/phase2/reaction-page-7.mp3",
    "text_sha256": "f6e2cfe2c815d313994c0c7ae2958a0a30b4a45061ba8afd1e421fbd44531375",
    "voice_id": "EUojVLG1QfxaqqH4ce6s",
    "voice_name": "Razan – Academic & Cultural Narration",
    "model": "eleven_multilingual_v2",
    "batch": "batch-2",
    "duration": 11.715,
    "bytes": 94292,
    "sha256": "bb6e2ac20d1122f6c64733081514b8deb822f35104a9dad3522547dca38eed2e",
    "alignment": 1.0,
    "cues": [
      {
        "start": 0.105,
        "end": 5.352,
        "text": "افحص الأنبوب الافتراضي والفلز والحمض المخفف. نفّذ الإضافة، ثم"
      },
      {
        "start": 5.48,
        "end": 9.694,
        "text": "قارن مؤشر الحرارة وحركة الفقاعات قبل التفاعل وبعده. أي"
      },
      {
        "start": 9.741,
        "end": 11.633,
        "text": "دليلين تستطيع ملاحظتهما؟"
      }
    ]
  },
  "reaction-page-8": {
    "file": "assets/audio/phase2/reaction-page-8.mp3",
    "text_sha256": "7b033e9253d7a81ffaadb9ba177c463ea602f724e7e7760f83a44ae1cfe79790",
    "voice_id": "EUojVLG1QfxaqqH4ce6s",
    "voice_name": "Razan – Academic & Cultural Narration",
    "model": "eleven_multilingual_v2",
    "batch": "batch-2",
    "duration": 10.548,
    "bytes": 84888,
    "sha256": "a0c0ef2b80629d3a0aedf55606b1cac38de3c474e927398304142d29c66dbe63",
    "alignment": 1.0,
    "cues": [
      {
        "start": 0.081,
        "end": 4.191,
        "text": "اختر الخبز أو الحليب، ثم أضف اليود افتراضيًا. قارن"
      },
      {
        "start": 4.238,
        "end": 8.627,
        "text": "لون العينة قبل الإضافة وبعدها، وأعد التجربة بالعينة الأخرى"
      },
      {
        "start": 8.836,
        "end": 10.392,
        "text": "قبل أن تفسر النتيجة."
      }
    ]
  },
  "reaction-page-9": {
    "file": "assets/audio/phase2/reaction-page-9.mp3",
    "text_sha256": "0e8706ecd5e4cfec807a6a1f1a3fccd3db9ba9b56d5042b33a69a4e99756e182",
    "voice_id": "EUojVLG1QfxaqqH4ce6s",
    "voice_name": "Razan – Academic & Cultural Narration",
    "model": "eleven_multilingual_v2",
    "batch": "batch-2",
    "duration": 10.739,
    "bytes": 86560,
    "sha256": "e9223889d0ae7ff078942335444ea23cf7be6a214518c332502516b45e2d2600",
    "alignment": 1.0,
    "cues": [
      {
        "start": 0.157,
        "end": 4.534,
        "text": "أمامك الماء المقطر وملح الطعام ومحلول نترات الفضة. رتب"
      },
      {
        "start": 4.579,
        "end": 8.632,
        "text": "الإضافات، ثم حرّك المحلول وراقب قاع الكأس. هل ترى"
      },
      {
        "start": 8.69,
        "end": 10.651,
        "text": "مادة جديدة تختلف عن المحلول؟"
      }
    ]
  },
  "reaction-page-10": {
    "file": "assets/audio/phase2/reaction-page-10.mp3",
    "text_sha256": "5416f8e97f174605803c565b69a4d67e5632fad08fcb7b4a8b4a4a7fd11564b7",
    "voice_id": "EUojVLG1QfxaqqH4ce6s",
    "voice_name": "Razan – Academic & Cultural Narration",
    "model": "eleven_multilingual_v2",
    "batch": "batch-2",
    "duration": 10.589,
    "bytes": 85306,
    "sha256": "2ae0f42a4483bb60fcad27d6945b4aaa5c3e4985859fa1b6e38d1d043ca3d07d",
    "alignment": 1.0,
    "cues": [
      {
        "start": 0.088,
        "end": 4.58,
        "text": "الكاشف الطبيعي محضّر ومبرّد في هذه المحاكاة. قارن أثر"
      },
      {
        "start": 4.627,
        "end": 8.609,
        "text": "الحمض وأثر محلول بيكربونات الصوديوم في ماء الملفوف. غيّر"
      },
      {
        "start": 8.702,
        "end": 10.502,
        "text": "عاملًا واحدًا ولاحظ اللون."
      }
    ]
  },
  "reaction-page-11": {
    "file": "assets/audio/phase2/reaction-page-11.mp3",
    "text_sha256": "ca3b1fb8aac0b69c6d6f1af1f4badf14ef9d8e2600d32b7ae6c3f1bd83f52ecc",
    "voice_id": "EUojVLG1QfxaqqH4ce6s",
    "voice_name": "Razan – Academic & Cultural Narration",
    "model": "eleven_multilingual_v2",
    "batch": "batch-2",
    "duration": 11.035,
    "bytes": 88859,
    "sha256": "d4d5592837226628e8393e9d6dc7543d21bf41ef75e240b812783f1c9f31eb02",
    "alignment": 1.0,
    "cues": [
      {
        "start": 0.087,
        "end": 5.242,
        "text": "تجربة المغنيسيوم هنا رقمية بالكامل. استخدم أدوات المحاكاة وتابع"
      },
      {
        "start": 5.276,
        "end": 9.537,
        "text": "التغير البصري منخفض الشدة. لاحظ المادة قبل التسخين وبعده،"
      },
      {
        "start": 9.711,
        "end": 10.919,
        "text": "ثم فسّر الدليل."
      }
    ]
  },
  "reaction-page-12": {
    "file": "assets/audio/phase2/reaction-page-12.mp3",
    "text_sha256": "df31e84e7106da3172bce0616c1b5aa451ebd4110c604d3665abff60ee3c0a3a",
    "voice_id": "EUojVLG1QfxaqqH4ce6s",
    "voice_name": "Razan – Academic & Cultural Narration",
    "model": "eleven_multilingual_v2",
    "batch": "batch-2",
    "duration": 13.81,
    "bytes": 111011,
    "sha256": "1eef5b1204573ae15c99c66593a8d10b060e04931ccf282c3a69ceaef278c723",
    "alignment": 1.0,
    "cues": [
      {
        "start": 0.116,
        "end": 4.284,
        "text": "اجمع أدلتك في خريطة الدرس. افتح مفهوم التفاعل، ثم"
      },
      {
        "start": 4.377,
        "end": 8.788,
        "text": "ميزان الذرات، ثم دلالات حدوث التفاعل. كبّر الرسوم واربط"
      },
      {
        "start": 8.858,
        "end": 12.98,
        "text": "كل ملاحظة بتفسيرها، دون الاعتماد على علامة واحدة خارج"
      },
      {
        "start": 13.096,
        "end": 13.711,
        "text": "سياقها."
      }
    ]
  },
  "bond-result-lif": {
    "file": "assets/audio/phase2/bond-result-lif.mp3",
    "text_sha256": "cfe3b9ed47a21240c80307149a8e3d8631dd133cdbbad862a300f007615c27d2",
    "voice_id": "EUojVLG1QfxaqqH4ce6s",
    "voice_name": "Razan – Academic & Cultural Narration",
    "model": "eleven_multilingual_v2",
    "batch": "batch-2",
    "duration": 11.122,
    "bytes": 89486,
    "sha256": "a6b9620a46f47069506a28706114b869ab8b4c6eef013ca2ecb26f75638dd96b",
    "alignment": 1.0,
    "cues": [
      {
        "start": 0.098,
        "end": 4.185,
        "text": "ماذا شاهدنا؟ انتقل إلكترون من Li إلى F؛ فأصبح"
      },
      {
        "start": 4.266,
        "end": 9.851,
        "text": "Li⁺ موجبًا وF⁻ سالبًا. التجاذب بين الشحنتين المختلفتين هو"
      },
      {
        "start": 9.897,
        "end": 11.035,
        "text": "الرابطة الأيونية."
      }
    ]
  },
  "bond-stage-lif-0": {
    "file": "assets/audio/phase2/bond-stage-lif-0.mp3",
    "text_sha256": "4b2b8b6f9274810d1257bd1a54853e5550a42211bb4a5334c4714eba810b02f5",
