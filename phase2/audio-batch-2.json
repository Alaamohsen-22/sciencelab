    "sha256": "8a89c21aebf70bad9815bce581e50bbbe229a351464ff4fc0aa9d9d1d64412b8",
    "alignment": 1.0,
    "cues": [
      {
        "start": 0.162,
        "end": 5.793,
        "text": "ماذا شاهدنا؟ يفقد Mg إلكترونين فيصبح Mg²⁺، وتكتسب كل"
      },
      {
        "start": 5.909,
        "end": 11.18,
        "text": "ذرة Cl إلكترونًا فتصبح أيون الكلوريد السالب. تتعادل الشحنات"
      },
      {
        "start": 11.238,
        "end": 15.302,
        "text": "بنسبة أيون مغنيسيوم إلى أيونَي كلور: كلوريد المغنيسيوم."
      }
    ]
  },
  "bond-stage-mgcl2-0": {
