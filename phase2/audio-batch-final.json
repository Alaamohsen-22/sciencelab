    "alignment": 1.0,
    "cues": [
      {
        "start": 0,
        "end": 4.76,
        "text": "في هذا النموذج تعادل أربع إضافات متساوية كمية القاعدة."
      },
      {
        "start": 4.853,
        "end": 10.136,
        "text": "يتحد الهيدروجين الموجب والهيدروكسيل السالب لتكوين الماء، وتبقى أيونات"
      },
      {
        "start": 10.182,
        "end": 14.687,
        "text": "الصوديوم والكلوريد. عند تبخر الماء تظهر بلورات كلوريد الصوديوم."
      },
      {
        "start": 14.872,
        "end": 17.369,
        "text": "زيادة الحمض تجعل المحلول حمضيًا."
      }
    ]
  },
  "lab-result-oxide": {
