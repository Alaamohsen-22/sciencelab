    "alignment": 1.0,
    "cues": [
      {
        "start": 0.145,
        "end": 4.476,
        "text": "يحترق الكبريت بلهب أزرق ويكوّن ثاني أكسيد الكبريت العديم"
      },
      {
        "start": 4.522,
        "end": 8.504,
        "text": "اللون. يظهر أثر حمضي مع الماء فتحمر الورقة الزرقاء"
      },
      {
        "start": 8.551,
        "end": 12.951,
        "text": "المبللة. وفي المثال الآخر يكون أكسيد الكالسيوم قاعديًا مع"
      },
      {
        "start": 12.998,
        "end": 17.897,
        "text": "الماء. أكسيد الألومنيوم متردد، ولا نعمم التصنيف على كل"
      },
      {
        "start": 17.943,
        "end": 18.675,
        "text": "الأكاسيد."
      }
    ]
  },
